{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ManabiIO/manabi-sentence-db/schemas/record-v1",
  "title": "Manabi Sentence DB canonical YAML record",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "license": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            },
            "notice": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "url"
          ],
          "additionalProperties": false
        },
        "attribution": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            }
          },
          "required": [
            "text",
            "url"
          ],
          "additionalProperties": false
        },
        "revision": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "timestamp": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            },
            "history_url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "kind": {
          "const": "document"
        },
        "sentences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "native_id": {
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "content_flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "review_state": {
                "enum": [
                  "unreviewed",
                  "reviewed"
                ]
              },
              "generation": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "human",
                      "machine"
                    ]
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "agent": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "machine"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "tool"
                      ]
                    }
                  }
                ]
              },
              "translations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "language": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "source_url": {
                      "type": "string",
                      "pattern": "^https?://[^\\s]+$"
                    },
                    "license": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "pattern": "^https?://[^\\s]+$"
                        },
                        "notice": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "url"
                      ],
                      "additionalProperties": false
                    },
                    "attribution": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "pattern": "^https?://[^\\s]+$"
                        }
                      },
                      "required": [
                        "text",
                        "url"
                      ],
                      "additionalProperties": false
                    },
                    "native_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "enum": [
                            "human",
                            "machine"
                          ]
                        },
                        "tool": {
                          "type": "string",
                          "minLength": 1
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1
                        },
                        "agent": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "kind": {
                                "const": "machine"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "tool"
                            ]
                          }
                        }
                      ]
                    },
                    "alignment": {
                      "enum": [
                        "direct-link",
                        "human",
                        "machine",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "language",
                    "text",
                    "text_sha256",
                    "source_url",
                    "license",
                    "attribution"
                  ],
                  "additionalProperties": false
                }
              },
              "source_range": {
                "type": "object",
                "properties": {
                  "unit": {
                    "enum": [
                      "character",
                      "utterance"
                    ]
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "unit",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "ordinal",
              "text",
              "text_sha256",
              "tags",
              "content_flags",
              "review_state",
              "translations"
            ],
            "additionalProperties": false
          }
        },
        "authorship": {
          "enum": [
            "human",
            "unknown"
          ]
        },
        "language_origin": {
          "enum": [
            "original_japanese",
            "human_translation",
            "unknown"
          ]
        },
        "published_at": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "source_text_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "source_id",
        "snapshot_id",
        "language",
        "native_id",
        "title",
        "url",
        "attribution",
        "tags",
        "license",
        "sentences",
        "transformations"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "attribution": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            }
          },
          "required": [
            "text",
            "url"
          ],
          "additionalProperties": false
        },
        "revision": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "timestamp": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            },
            "history_url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "kind": {
          "const": "reference"
        },
        "locator": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "text-fragment"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://[^\\s]+#:~:text=.+$"
                }
              },
              "required": [
                "type",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "media"
                },
                "start_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "end_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "type",
                "start_seconds"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "source_id",
        "snapshot_id",
        "language",
        "native_id",
        "title",
        "url",
        "attribution",
        "tags",
        "locator"
      ],
      "additionalProperties": false
    }
  ]
}
